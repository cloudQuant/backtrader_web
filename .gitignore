# Runtime-generated backend state & live-trading credentials (iteration 177 §D).
# These are written by the app at runtime and have historically leaked real
# API keys / passwords into git. Keep them out of version control; the backend
# recreates them on demand and falls back to defaults when absent.
src/backend/data/manual_gateways.json
src/backend/data/manual_gateways/
src/backend/data/sync_config.json
src/backend/data/sync_history.json
src/backend/data/auto_trading_config.json
src/backend/data/live_trading_instances.json
src/backend/data/quote_custom_symbols.json
src/backend/data/reqdocs_source_files/
# slowapi optional runtime config-override file (iteration 179 §A). Written by
# the rate limiter at runtime; not a secret today but is runtime state that
# should never be tracked. The limiter only loads it when present.
src/backend/.slowapi.env
**/.slowapi.env
workspace_units/
scripts/diag_*.txt
