# Iteration 197 browser rollout controls
#
# Keep all three disabled until the corresponding server-side gates, source
# registry/RBAC provisioning, and acceptance evidence have been approved.
# The browser flags never enable backend routes or online fetching by themselves.
VITE_MARKET_DATA_QUERY_V2_ENABLED=false
VITE_MARKET_DATA_QUERY_BUNDLE_ENABLED=false
# Requires the v2 page gate above and an Iteration 196/197 integration candidate.
VITE_MARKET_DATA_STRATEGY_BRIDGE_ENABLED=false
