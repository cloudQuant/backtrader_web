# AI for Investor Docker environment example
# Replace all placeholder secrets before use.

# App
APP_NAME=ai-for-investor
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=backtrader
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=ai_for_investor
MYSQL_ROOT_PASSWORD=replace-with-your-mysql-root-password
MYSQL_DATA_DIR=./runtime/mysql

# Redis
REDIS_DATA_DIR=./runtime/redis

# Backend runtime
BACKEND_LOGS_DIR=./runtime/backend/logs
BACKEND_APP_DATA_DIR=./runtime/backend/data
DB_AUTO_CREATE_SCHEMA=false
DB_AUTO_CREATE_DEFAULT_ADMIN=false
BACKTEST_TIMEOUT=300
HOST=127.0.0.1
PORT=8000
AKSHARE_SCHEDULER_TIMEZONE=Asia/Shanghai
AKSHARE_SCRIPT_ROOT=app/data_fetch/scripts
AKSHARE_INTERFACE_BOOTSTRAP_MODE=manual
RISK_FREE_RATE_DEFAULT=0.04
AI_CHAT_ENABLED=false
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_TIMEOUT=120
AI_CHAT_TEMPERATURE=0.2

# Trusted AI-research protocol v2. Keep both flags false until implementation
# acceptance and an approved rollout. The worker factory must be a reviewed,
# image-local app.research_deployments callable; never put provider secrets here.
AI_RESEARCH_PROTOCOL_V2_ENABLED=false
# Server-owned immutable workflow for new runs. Browsers cannot select this.
AI_RESEARCH_PROTOCOL_V2_WORKFLOW_VERSION=generation-v1
AI_RESEARCH_PROTOCOL_V2_WORKER_ENABLED=false
AI_RESEARCH_PROTOCOL_V2_WORKER_FACTORY=
AI_RESEARCH_PROTOCOL_V2_WORKER_POLL_SECONDS=10
# Independent sealed-holdout process. This remains disabled and incomplete by
# default. Supply endpoint/token/identities from deployment secrets; examples
# and local HTTP seams are not evidence that a real evaluator is reachable.
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_WORKER_ENABLED=false
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_WORKER_FACTORY=
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_WORKER_POLL_SECONDS=10
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_ENDPOINT_URL=
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_BEARER_TOKEN=
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_WORKER_IDENTITY=
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_EVALUATOR_IDENTITY=
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_EVALUATOR_IMAGE_DIGEST=
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_HTTP_TIMEOUT_SECONDS=60
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_MAX_RESPONSE_BYTES=10000000
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_LEASE_SECONDS=300
AI_RESEARCH_PROTOCOL_V2_HOLDOUT_HEARTBEAT_SECONDS=30
# Dataset receipts stay disabled until a deployment provisions separate, service-owned roots.
AI_RESEARCH_PROTOCOL_V2_DATASET_OBJECT_RESOLVER_TYPE=
AI_RESEARCH_PROTOCOL_V2_DATASET_FILESYSTEM_ROOT=
AI_RESEARCH_PROTOCOL_V2_DATASET_RECEIPT_STORE=
AI_RESEARCH_PROTOCOL_V2_DATASET_MAX_BYTES=0
# Optional real GENERATE deployment. Keep empty unless the same worker image is
# explicitly enabled above and supplied a reviewed static route/policy. This is
# not the user-facing AI provider registry; never commit a real API key here.
AI_RESEARCH_PROTOCOL_V2_GENERATION_PROVIDER_ID=
AI_RESEARCH_PROTOCOL_V2_GENERATION_ENDPOINT_URL=
AI_RESEARCH_PROTOCOL_V2_GENERATION_MODEL_ALIAS=
AI_RESEARCH_PROTOCOL_V2_GENERATION_MODEL_ID=
AI_RESEARCH_PROTOCOL_V2_GENERATION_API_KEY=
AI_RESEARCH_PROTOCOL_V2_GENERATION_TIMEOUT_SECONDS=60
AI_RESEARCH_PROTOCOL_V2_GENERATION_MAX_OUTPUT_TOKENS=1024
AI_RESEARCH_PROTOCOL_V2_GENERATION_MAX_RESPONSE_BYTES=2097152
AI_RESEARCH_PROTOCOL_V2_GENERATION_MAX_REQUEST_BYTES=524288
AI_RESEARCH_PROTOCOL_V2_GENERATION_PROMPT_TEMPLATE_VERSION=
AI_RESEARCH_PROTOCOL_V2_GENERATION_PROMPT_CONTENT=
AI_RESEARCH_PROTOCOL_V2_GENERATION_PROMPT_CONTENT_HASH=
AI_RESEARCH_PROTOCOL_V2_GENERATION_SAMPLING_PARAMS_JSON={}
AI_RESEARCH_PROTOCOL_V2_GENERATION_QUOTA_POLICY_VERSION=
# Reviewed all-inclusive accounting contract and independently pinned canonical hash.
# Empty denies dispatch. Never substitute an estimated tokenizer or unreviewed price.
AI_RESEARCH_PROTOCOL_V2_GENERATION_ACCOUNTING_POLICY_JSON=
AI_RESEARCH_PROTOCOL_V2_GENERATION_ACCOUNTING_POLICY_HASH=
# Per-call input + output token ceiling, not just max_tokens.
AI_RESEARCH_PROTOCOL_V2_GENERATION_RESERVED_TOKENS=0
AI_RESEARCH_PROTOCOL_V2_GENERATION_QUOTA_LEASE_SECONDS=900
AI_RESEARCH_PROTOCOL_V2_GENERATION_MATERIALIZATION_POLICY_VERSION=
AI_RESEARCH_PROTOCOL_V2_GENERATION_ENVIRONMENT_MANIFEST_JSON={}
# Optional remote VALIDATE_DISCOVERY deployment. These deliberately invalid
# placeholders fail closed even if the rollout flags above are enabled. Supply
# a reviewed HTTPS runner route and policy through deployment secrets only.
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_ENDPOINT_URL=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_BEARER_TOKEN=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_RUNNER_IDENTITY=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_HTTP_TIMEOUT_SECONDS=0
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_POLICY_VERSION=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_IMAGE_DIGEST=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_NETWORK_MODE=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_INPUT_READ_ONLY=false
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_OUTPUT_PATH=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_CPU_LIMIT=0
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_MEMORY_LIMIT_MB=0
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_PID_LIMIT=0
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_WALL_TIMEOUT_SECONDS=0
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_SANDBOX_OUTPUT_LIMIT_BYTES=0
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_QUOTA_POLICY_VERSION=
AI_RESEARCH_PROTOCOL_V2_DISCOVERY_QUOTA_LEASE_SECONDS=0
VOLCENGINE_ARK_API_KEY=replace-with-volcengine-ark-key
SILICONFLOW_API_KEY=replace-with-siliconflow-key
AI_PROVIDERS='{"openai":{"display_name":"OpenAI","provider_type":"litellm","base_url":null,"api_key_env":"OPENAI_API_KEY","models":["gpt-4o","gpt-4o-mini"]},"anthropic":{"display_name":"Anthropic","provider_type":"litellm","base_url":null,"api_key_env":"ANTHROPIC_API_KEY","models":["claude-3-5-sonnet-latest","claude-3-5-haiku-latest"]},"ollama":{"display_name":"Ollama","provider_type":"litellm","base_url":"http://localhost:11434","api_key_env":null,"models":["ollama/qwen2.5-coder:7b","ollama/llama3.1:8b"]},"volcengine_ark":{"display_name":"火山方舟","provider_type":"openai_compatible","base_url":"https://ark.cn-beijing.volces.com/api/coding/v3","api_key_env":"VOLCENGINE_ARK_API_KEY","models":["doubao-seed-2.0-code","doubao-seed-2.0-pro","doubao-seed-2.0-lite","doubao-seed-code","minimax-m2.7","minimax-m3","glm-5.1","deepseek-v4-flash","deepseek-v4-pro","kimi-k2.6"]},"siliconflow":{"display_name":"硅基流动","provider_type":"openai_compatible","base_url":"https://api.siliconflow.cn/v1","api_key_env":"SILICONFLOW_API_KEY","models":["deepseek-ai/DeepSeek-V4-Pro","deepseek-ai/DeepSeek-V4-Flash","moonshotai/Kimi-K2.6","zai-org/GLM-5.1"]},"together":{"display_name":"Together AI","provider_type":"litellm","base_url":null,"api_key_env":"TOGETHER_API_KEY","models":["together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo"]},"groq":{"display_name":"Groq","provider_type":"litellm","base_url":null,"api_key_env":"GROQ_API_KEY","models":["groq/llama-3.3-70b-versatile"]}}'
TZ=Asia/Shanghai

# Data connector provider keys (iteration 170)
FRED_API_KEY=replace-with-fred-api-key
FMP_API_KEY=replace-with-fmp-api-key

# Broker bridge / broker secret references (iteration 170)
BT_API_PY_BRIDGE_ENABLE_WRITE=0
BT_BROKER_SIM_KEY=replace-with-broker-key
BT_BROKER_SIM_SECRET=replace-with-broker-secret

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com

# Network
HTTP_PORT=80
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Local Docker override values
LOCAL_HTTP_PORT=8080
LOCAL_BACKEND_PORT=8000
LOCAL_REDIS_DATA_DIR=./runtime/local/redis
LOCAL_BACKEND_LOGS_DIR=./runtime/local/backend/logs
LOCAL_BACKEND_APP_DATA_DIR=./runtime/local/backend/data

# ─── AI Trading (Natural Language Trading) ───────────────────────────────────
# Requires AI_CHAT_ENABLED=true and a configured AI provider above.
# AI_TRADING_MAX_SINGLE_AMOUNT=10000    # Max single trade value
# AI_TRADING_MAX_DAILY_TRADES=50        # Max trades per day
# AI_TRADING_MAX_POSITION_RATIO=0.3     # Max position as % of account
# AI_TRADING_CONFIRM_ABOVE=5000         # Require confirmation above this value
# AI_TRADING_BLOCKED_SYMBOLS=           # Comma-separated blocked symbols
# AI_TRADING_DEFAULT_MODE=paper         # paper or live

# Rate limits (raise for dev/test; keep tight in production)
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
