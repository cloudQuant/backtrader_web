# AI for Trader Docker environment example
# Replace all placeholder secrets before use.

# App
APP_NAME=ai-for-trader
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=backtrader
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=ai_for_trader
MYSQL_ROOT_PASSWORD=replace-with-your-mysql-root-password
MYSQL_DATA_DIR=./runtime/mysql

# Redis
REDIS_DATA_DIR=./runtime/redis

# Backend runtime
BACKEND_LOGS_DIR=./runtime/backend/logs
BACKEND_APP_DATA_DIR=./runtime/backend/data
DB_AUTO_CREATE_SCHEMA=false
DB_AUTO_CREATE_DEFAULT_ADMIN=false
BACKTEST_TIMEOUT=300
HOST=127.0.0.1
PORT=8000
AKSHARE_SCHEDULER_TIMEZONE=Asia/Shanghai
AKSHARE_SCRIPT_ROOT=app/data_fetch/scripts
AKSHARE_INTERFACE_BOOTSTRAP_MODE=manual
RISK_FREE_RATE_DEFAULT=0.04
AI_CHAT_ENABLED=false
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_TIMEOUT=120
AI_CHAT_TEMPERATURE=0.2
VOLCENGINE_ARK_API_KEY=replace-with-volcengine-ark-key
SILICONFLOW_API_KEY=replace-with-siliconflow-key
AI_PROVIDERS='{"openai":{"display_name":"OpenAI","provider_type":"litellm","base_url":null,"api_key_env":"OPENAI_API_KEY","models":["gpt-4o","gpt-4o-mini"]},"anthropic":{"display_name":"Anthropic","provider_type":"litellm","base_url":null,"api_key_env":"ANTHROPIC_API_KEY","models":["claude-3-5-sonnet-latest","claude-3-5-haiku-latest"]},"ollama":{"display_name":"Ollama","provider_type":"litellm","base_url":"http://localhost:11434","api_key_env":null,"models":["ollama/qwen2.5-coder:7b","ollama/llama3.1:8b"]},"volcengine_ark":{"display_name":"火山方舟","provider_type":"openai_compatible","base_url":"https://ark.cn-beijing.volces.com/api/coding/v3","api_key_env":"VOLCENGINE_ARK_API_KEY","models":["doubao-seed-2.0-code","doubao-seed-2.0-pro","doubao-seed-2.0-lite","doubao-seed-code","minimax-m2.7","minimax-m3","glm-5.1","deepseek-v4-flash","deepseek-v4-pro","kimi-k2.6"]},"siliconflow":{"display_name":"硅基流动","provider_type":"openai_compatible","base_url":"https://api.siliconflow.cn/v1","api_key_env":"SILICONFLOW_API_KEY","models":["deepseek-ai/DeepSeek-V4-Pro","deepseek-ai/DeepSeek-V4-Flash","moonshotai/Kimi-K2.6","zai-org/GLM-5.1"]},"together":{"display_name":"Together AI","provider_type":"litellm","base_url":null,"api_key_env":"TOGETHER_API_KEY","models":["together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo"]},"groq":{"display_name":"Groq","provider_type":"litellm","base_url":null,"api_key_env":"GROQ_API_KEY","models":["groq/llama-3.3-70b-versatile"]}}'
TZ=Asia/Shanghai

# Data connector provider keys (iteration 170)
FRED_API_KEY=replace-with-fred-api-key
FMP_API_KEY=replace-with-fmp-api-key

# Broker bridge / broker secret references (iteration 170)
BT_API_PY_BRIDGE_ENABLE_WRITE=0
BT_BROKER_SIM_KEY=replace-with-broker-key
BT_BROKER_SIM_SECRET=replace-with-broker-secret

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com

# Network
HTTP_PORT=80
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Local Docker override values
LOCAL_HTTP_PORT=8080
LOCAL_BACKEND_PORT=8000
LOCAL_REDIS_DATA_DIR=./runtime/local/redis
LOCAL_BACKEND_LOGS_DIR=./runtime/local/backend/logs
LOCAL_BACKEND_APP_DATA_DIR=./runtime/local/backend/data

# ─── AI Trading (Natural Language Trading) ───────────────────────────────────
# Requires AI_CHAT_ENABLED=true and a configured AI provider above.
# AI_TRADING_MAX_SINGLE_AMOUNT=10000    # Max single trade value
# AI_TRADING_MAX_DAILY_TRADES=50        # Max trades per day
# AI_TRADING_MAX_POSITION_RATIO=0.3     # Max position as % of account
# AI_TRADING_CONFIRM_ABOVE=5000         # Require confirmation above this value
# AI_TRADING_BLOCKED_SYMBOLS=           # Comma-separated blocked symbols
# AI_TRADING_DEFAULT_MODE=paper         # paper or live
