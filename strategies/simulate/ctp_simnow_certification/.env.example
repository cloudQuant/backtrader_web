# SimNow CTP simulation credentials. Copy this file to .env; never commit .env.
SIMNOW_USER_ID=your_simnow_investor_id
SIMNOW_PASSWORD=your_simnow_password

# Choose one: new_7x24, new_group1, new_group2, new_group3.
SIMNOW_ENV=new_7x24

# Set these to a contract that is active in your SimNow environment.
SIMNOW_ORDER_SYMBOL=rb2610
SIMNOW_TICK_SYMBOL=rb2610
