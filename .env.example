# Backtrader Web Docker environment example
# Copy this file to src/backend/.env and replace all placeholder secrets before use.

# App
APP_NAME=backtrader_web
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
# JWT lifetime in minutes. Short-lived access tokens are recommended; rely on the
# refresh-token endpoint to extend sessions. Hard cap is 10080 (7 days).
JWT_EXPIRE_MINUTES=60

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=backtrader
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=backtrader_web
MYSQL_ROOT_PASSWORD=replace-with-your-mysql-root-password
MYSQL_DATA_DIR=./runtime/mysql

# Redis
REDIS_DATA_DIR=./runtime/redis

# Backend runtime
BACKEND_LOGS_DIR=./runtime/backend/logs
BACKEND_APP_DATA_DIR=./runtime/backend/data
DB_AUTO_CREATE_SCHEMA=false
DB_AUTO_CREATE_DEFAULT_ADMIN=false
BACKTEST_TIMEOUT=300
HOST=127.0.0.1
PORT=8000
AKSHARE_SCHEDULER_TIMEZONE=Asia/Shanghai
AKSHARE_SCRIPT_ROOT=app/data_fetch/scripts
AKSHARE_INTERFACE_BOOTSTRAP_MODE=manual
RISK_FREE_RATE_DEFAULT=0.04
TZ=Asia/Shanghai

# Data connector provider keys (iteration 170)
FRED_API_KEY=replace-with-fred-api-key
FMP_API_KEY=replace-with-fmp-api-key

# Broker bridge / broker secret references (iteration 170)
BT_API_PY_BRIDGE_ENABLE_WRITE=0
BT_BROKER_SIM_KEY=replace-with-broker-key
BT_BROKER_SIM_SECRET=replace-with-broker-secret

# AI runtime
AI_CHAT_ENABLED=false
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_API_KEY=replace-with-openai-compatible-key
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_TIMEOUT=60
AI_CHAT_TEMPERATURE=0.2

# AI budget control
# AI_BUDGET_MODE: soft (observe only) or hard (block when daily budget is exceeded)
AI_BUDGET_DAILY_USD=5.0
AI_BUDGET_MODE=soft

# Multi-provider registry. JSON must stay on one line for .env parsing.
AI_PROVIDERS={"openai":{"base_url":null,"api_key_env":"OPENAI_API_KEY","models":["gpt-4o","gpt-4o-mini"]},"ollama":{"base_url":"http://localhost:11434","api_key_env":null,"models":["ollama/qwen2.5-coder:7b","ollama/llama3.1:8b"]}}
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
TOGETHER_API_KEY=replace-with-together-key
GROQ_API_KEY=replace-with-groq-key

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com

# Network
HTTP_PORT=80
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Production: Gunicorn worker count (default 2, set to 1 for single-worker mode)
WEB_CONCURRENCY=2

# Logging configuration
# LOG_LEVEL: Explicit override (DEBUG/INFO/WARNING/ERROR/CRITICAL). Empty = auto.
# Auto: DEBUG=true → all levels; DEBUG=false → console=WARNING, file=INFO
LOG_LEVEL=
LOG_DIR=./runtime/backend/logs
LOG_RETENTION_APP_DAYS=30
LOG_RETENTION_ERROR_DAYS=90
LOG_RETENTION_AUDIT_DAYS=365

# Audit trail (user operation tracking in database)
AUDIT_RETENTION_DAYS=90
AUDIT_CLEANUP_HOUR=2
AUDIT_EVENT_MAX_SIZE_KB=10

# Airflow integration (data orchestration)
# ORCHESTRATION_BACKEND: auto (detect Airflow, fallback APScheduler), airflow, apscheduler
ORCHESTRATION_BACKEND=auto
AIRFLOW_API_BASE_URL=http://localhost:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_OUTPUT_DIR=./dags
AIRFLOW_CALLBACK_BASE_URL=http://localhost:8000

# OpenTelemetry distributed tracing (included in core dependencies)
# Set to true/1/yes to enable (case-insensitive)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backtrader-web-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Local Docker override values
LOCAL_HTTP_PORT=8080
LOCAL_BACKEND_PORT=8000
LOCAL_REDIS_DATA_DIR=./runtime/local/redis
LOCAL_BACKEND_LOGS_DIR=./runtime/local/backend/logs
LOCAL_BACKEND_APP_DATA_DIR=./runtime/local/backend/data
